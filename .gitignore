# =============================================================================
# PUBLIC REPOSITORY: never commit connection strings, passwords, keys,
# certificates, or database data. Keep secrets in user-secrets, environment
# variables, or a secret manager. Commit only sanitized *.example templates.
# =============================================================================

# -----------------------------------------------------------------------------
# Secrets & local configuration
# -----------------------------------------------------------------------------
appsettings.Development.json
appsettings.Local.json
appsettings.*.Local.json
appsettings.Secrets.json
secrets.json
*.secrets.json
connectionstrings.json
**/Properties/launchSettings.local.json

# Environment files (allow sanitized templates)
.env
.env.*
*.env
!.env.example
!*.env.example

# Keys, certificates, credentials
*.pfx
*.p12
*.pem
*.key
